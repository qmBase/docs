# Default: normalize text files and store with LF
* text=auto eol=lf

# Source code
*.cs      text eol=lf
*.csproj  text eol=lf
*.sln     text eol=lf
*.slnx    text eol=lf

*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.jsx     text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.scss    text eol=lf
*.html    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

# Shell scripts MUST use LF
*.sh       text eol=lf

# Windows-specific scripts
*.bat      text eol=crlf
*.cmd      text eol=crlf

# Don't modify binary files
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.zip      binary
*.7z       binary
*.woff     binary
*.woff2    binary
*.ttf      binary