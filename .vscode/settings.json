{
  "cSpell.language": ",de",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit",
    "source.sortMembers": "explicit"
  },
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "[plaintext]": { "editor.defaultFormatter": "oxc.oxc-vscode", "editor.formatOnSave": true },
  "[markdown]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[mdx]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "chat.tools.terminal.autoApprove": {
    "/^node -e \"JSON\\.parse\\(require\\('fs'\\)\\.readFileSync\\('\\.devcontainer/devcontainer\\.json','utf8'\\)\\); console\\.log\\('devcontainer\\.json valid'\\)\"$/": {
      "approve": true,
      "matchCommandLine": true
    }
  }
}
